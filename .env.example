# Copy to your MCP client config (or export in your shell). Never commit real values.
# API key from https://developers.mindbodyonline.com
MBO_API_KEY=your-api-key
# Staff login for the site (the public sandbox staff login is in the Mindbody developer docs)
MBO_USERNAME=your-staff-username
MBO_PASSWORD=your-staff-password
# Default SiteId; -99 is Mindbody's public sandbox
MBO_SITE_ID=-99

# Optional, both off by default
# MBO_ALLOW_WRITES=true
# MBO_ALLOW_WEBHOOK_ADMIN=true
# MBO_MCP_PROGRESS=off

{
  "name": "mindbody-mcp-server",
  "version": "0.1.0",
  "description": "Unofficial MCP server for the Mindbody Public API v6, read-only by default with PII masking",
  "type": "module",
  "bin": {
    "mindbody-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Richard Froom",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
